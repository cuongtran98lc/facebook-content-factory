DATABASE_URL="file:./dev.db"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""

# Final MP3, thumbnail and video output. Empty = ./output when running from source.
# Each project gets one stable folder: output/<story-name>--<project-id>/
CONTENT_FACTORY_OUTPUT_DIR=""

# TTS provider: elevenlabs | capcut
# CapCut mode is experimental and expects a local bridge that wraps your own
# authenticated CapCut Desktop/Web session. Do not commit session tokens/cookies.
TTS_PROVIDER="elevenlabs"
CAPCUT_TTS_BRIDGE_URL="http://127.0.0.1:8000"
CAPCUT_TTS_RATE="1"
CAPCUT_CAPTURE_MAX_AGE_HOURS="24"
CAPCUT_CAPTURE_REQUIRED="false"
CAPCUT_TTS_SYSTEM_FALLBACK="false"
MACOS_TTS_VOICE="Linh"
MACOS_TTS_RATE="175"
MACOS_REVIEW_TTS_RATE="188"
MACOS_REVIEW_TTS_PITCH="0"
EDGE_TTS_RATE="+5%"
EDGE_TTS_PITCH="+0Hz"
