{
  "name": "content-factory-desktop",
  "version": "0.3.3",
  "private": true,
  "description": "Local desktop content production tool for AI story/reel workflows",
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "npm install && npm run setup:bridge && npm run db:push && npm run verify",
    "setup:bridge": "python3 -m venv tools/capcut_bridge/.venv && tools/capcut_bridge/.venv/bin/python -m pip install --upgrade pip && tools/capcut_bridge/.venv/bin/python -m pip install -r tools/capcut_bridge/requirements.txt",
    "prestart": "npm run setup:bridge && npm run db:generate && npm run db:push && npm run bridge:check-config && npm run capture:check",
    "start": "node tools/start-dev.mjs",
    "dev": "electron-vite dev",
    "dev:capcut": "TTS_PROVIDER=capcut CAPCUT_TTS_BRIDGE_URL=http://127.0.0.1:8000 electron-vite dev",
    "bridge": "tools/capcut_bridge/.venv/bin/python -m uvicorn app:app --app-dir tools/capcut_bridge --host 127.0.0.1 --port 8000",
    "bridge:reload": "tools/capcut_bridge/.venv/bin/python -m uvicorn app:app --app-dir tools/capcut_bridge --host 127.0.0.1 --port 8000 --reload",
    "bridge:health": "node tools/check-bridge.mjs",
    "bridge:check-config": "tools/capcut_bridge/.venv/bin/python -m json.tool tools/capcut_bridge/capcut.local.json > /dev/null",
    "capture:check": "node tools/check-capcut-capture.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "verify": "npm run bridge:check-config && npm run typecheck && npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.1.2",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.6",
    "electron-vite": "^4.0.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
